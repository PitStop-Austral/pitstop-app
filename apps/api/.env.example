# Optional API override
PORT=3001

# Local PostgreSQL for development — also injected into the postgres container via
# docker-compose.yml's env_file. Note: the host port mapping in docker-compose.yml is hardcoded
# to 5433 (Compose can't read it from here), so changing POSTGRES_PORT only affects DATABASE_URL
# below, not the actual container port — edit docker-compose.yml directly if you need that to change.
POSTGRES_USER=pitstop
POSTGRES_PASSWORD=pitstop
POSTGRES_DB=pitstop
POSTGRES_PORT=5433

# Build this from the POSTGRES_* values above, so it stays in sync with the local database
# started by `pnpm db:up`.
DATABASE_URL=postgresql://pitstop:pitstop@localhost:5433/pitstop

# Neon's direct (non-pooled) connection string, used only for `prisma migrate` (see prisma.config.ts).
# Not needed locally (no pooler) — leave empty and it falls back to DATABASE_URL above.
DIRECT_URL=

# Origin allowed by CORS (no wildcards). Matches the Vite dev server below.
WEB_ORIGIN=http://localhost:3000

# Firebase Admin (api) — from Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
