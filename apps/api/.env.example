# Optional API override
PORT=3001

# Build this from the same POSTGRES_* values as the root .env, so it stays in sync with the
# local database started by `docker compose up -d`.
DATABASE_URL=postgresql://pitstop:pitstop@localhost:5433/pitstop

# Firebase Admin (api) — from Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
