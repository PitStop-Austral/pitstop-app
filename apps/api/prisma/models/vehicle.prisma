enum FuelType {
  NAFTA
  DIESEL
  GNC
  HIBRIDO
  ELECTRICO
}

model Vehicle {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  brand     String
  model     String
  year      Int
  fuel      FuelType
  plate     String
  mileage   Int
  nickname  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id])

  @@unique([ownerId, plate])
  @@index([ownerId])
}
