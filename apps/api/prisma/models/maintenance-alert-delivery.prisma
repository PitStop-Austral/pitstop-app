enum MaintenanceAlertDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model MaintenanceAlertDelivery {
  id                   String                         @id @default(uuid()) @db.Uuid
  scheduleId           String                         @db.Uuid
  cycleId              String?                        @db.Uuid
  installationId       String                         @db.Uuid
  notificationDeviceId String?                        @db.Uuid
  dueKey               String
  dueDate              DateTime?                      @db.Date
  dueMileage           Int?
  status               MaintenanceAlertDeliveryStatus @default(PENDING)
  fcmMessageId         String?
  errorCode            String?
  attemptedAt          DateTime                       @default(now()) @db.Timestamptz(3)
  finishedAt           DateTime?                      @db.Timestamptz(3)
  cycle                MaintenanceAlertCycle?         @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  notificationDevice   NotificationDevice?            @relation(fields: [notificationDeviceId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, installationId, dueKey])
  @@index([notificationDeviceId])
  @@index([cycleId])
  @@index([status, attemptedAt])
}
