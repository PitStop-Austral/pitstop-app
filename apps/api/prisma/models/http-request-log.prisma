enum HttpRequestOutcome {
  COMPLETED
  ABORTED
}

enum HttpRequestTrafficKind {
  APPLICATION
  HEALTH
  REPORTING
  UNMATCHED
}

model HttpRequestLog {
  id          String                 @id @db.Uuid
  method      String
  route       String?
  startedAt   DateTime               @db.Timestamptz(3)
  endedAt     DateTime               @db.Timestamptz(3)
  durationMs  Float
  statusCode  Int?
  outcome     HttpRequestOutcome
  trafficKind HttpRequestTrafficKind

  @@index([startedAt])
  @@index([trafficKind, startedAt])
}
